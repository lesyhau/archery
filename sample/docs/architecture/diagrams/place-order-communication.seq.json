{
  "version": 1,
  "type": "sequence",
  "title": "Place order (communication)",
  "lifelines": [
    {
      "ref": "customer"
    },
    {
      "ref": "storefront"
    },
    {
      "ref": "orderService"
    },
    {
      "ref": "paymentGateway"
    }
  ],
  "steps": [
    {
      "msg": {
        "from": "customer",
        "to": "storefront",
        "label": "checkout()",
        "kind": "sync"
      }
    },
    {
      "msg": {
        "from": "storefront",
        "to": "orderService",
        "label": "placeOrder(cart)",
        "kind": "sync"
      }
    },
    {
      "msg": {
        "from": "orderService",
        "to": "orderService",
        "label": "validate()",
        "kind": "self"
      }
    },
    {
      "fragment": "loop",
      "branches": [
        {
          "guard": "stock not reserved",
          "steps": [
            {
              "msg": {
                "from": "orderService",
                "to": "orderService",
                "label": "reserveStock()",
                "kind": "self"
              }
            }
          ]
        }
      ],
      "min": 1,
      "max": 3
    },
    {
      "msg": {
        "from": "orderService",
        "to": "paymentGateway",
        "label": "charge(amount)",
        "kind": "sync"
      }
    },
    {
      "constraint": "response < 2s",
      "over": [
        "paymentGateway"
      ]
    },
    {
      "fragment": "alt",
      "branches": [
        {
          "guard": "payment ok",
          "steps": [
            {
              "msg": {
                "from": "paymentGateway",
                "to": "orderService",
                "label": "ok",
                "kind": "reply"
              }
            },
            {
              "msg": {
                "from": "orderService",
                "to": "storefront",
                "label": "confirmation",
                "kind": "reply"
              }
            }
          ]
        },
        {
          "guard": "else",
          "steps": [
            {
              "msg": {
                "from": "paymentGateway",
                "to": "orderService",
                "label": "declined",
                "kind": "reply"
              }
            },
            {
              "msg": {
                "from": "orderService",
                "to": "storefront",
                "label": "error",
                "kind": "reply"
              }
            }
          ]
        }
      ]
    },
    {
      "msg": {
        "from": "orderService",
        "label": "audit event",
        "kind": "lost"
      }
    },
    {
      "msg": {
        "from": "orderService",
        "label": "orderPlaced",
        "kind": "lost",
        "async": true,
        "gate": true
      }
    },
    {
      "msg": {
        "from": "storefront",
        "to": "customer",
        "label": "show result",
        "kind": "reply"
      }
    }
  ],
  "notation": "communication"
}
